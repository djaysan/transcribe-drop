{
  "manifest_version": 3,
  "name": "Transcribe Drop",
  "version": "1.0",
  "description": "Adds the call's video to a Transcribe Drop meeting recording.",
  "key": "",
  "permissions": [
    "tabCapture",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:47913/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Transcribe Drop: record this tab's video",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    }
  }
}
